@page
@model WildTrailsIndia.Views.Home.IndexModel
@{
}
@{

    Layout = "_PublicLayout";
}
<section class="section" id="categories">

    <div class="section-header">

        <div>
            <h2>Find Your Adventure</h2>
            <p>Choose the experience that matches your spirit.</p>
        </div>

        <a href="#trips" class="view-all">
            View All →
        </a>

    </div>

    <div class="categories">

        <div class="category"
             style="background-image:url('https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&w=800&q=80')">
            <div class="category-content">
                <h3>🥾 Trekking</h3>
                <p>Explore the mountains</p>
            </div>
        </div>

        <div class="category"
             style="background-image:url('https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=800&q=80')">
            <div class="category-content">
                <h3>⛺ Camping</h3>
                <p>Sleep under the stars</p>
            </div>
        </div>

        <div class="category"
             style="background-image:url('https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=800&q=80')">
            <div class="category-content">
                <h3>🚙 Road Trips</h3>
                <p>Roads less travelled</p>
            </div>
        </div>

        <div class="category"
             style="background-image:url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=800&q=80')">
            <div class="category-content">
                <h3>🌴 Weekend</h3>
                <p>Escape the routine</p>
            </div>
        </div>

    </div>

</section>


<!-- ================= TRIPS ================= -->

<section class="section section-light" id="trips">

    <div class="section-header">

        <div>
            <h2>Popular Adventures</h2>
            <p>Handpicked trips for your next unforgettable journey.</p>
        </div>

        <a href="#" class="view-all">
            See All Trips →
        </a>

    </div>


    <div class="trips" id="tripContainer">

        <!-- TRIP 1 -->
        <article class="trip-card"
                 data-name="Kedarkantha Trek"
                 data-location="Uttarakhand"
                 data-category="Trekking">

            <div class="trip-image">

                <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=80">

                <span class="trip-badge">
                    Bestseller
                </span>

            </div>

            <div class="trip-content">

                <div class="location">
                    📍 Uttarakhand
                </div>

                <h3>Kedarkantha Trek</h3>

                <div class="trip-info">
                    <span>⏱ 5 Days</span>
                    <span>🏔 Moderate</span>
                    <span>⭐ 4.9</span>
                </div>

                <div class="trip-bottom">

                    <div class="price">
                        ₹7,999 <small>/ person</small>
                    </div>

                    <button class="add-cart"
                            onclick="addToCart('Kedarkantha Trek',7999,'Uttarakhand','https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=500&q=80')">
                        + Cart
                    </button>

                </div>

            </div>

        </article>

        <!-- TRIP 2 -->
        <article class="trip-card"
                 data-name="Himachal Adventure"
                 data-location="Himachal Pradesh"
                 data-category="Trekking">

            <div class="trip-image">

                <img src="https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=1000&q=80">

                <span class="trip-badge">
                    Popular
                </span>

            </div>

            <div class="trip-content">

                <div class="location">
                    📍 Himachal Pradesh
                </div>

                <h3>Himachal Adventure</h3>

                <div class="trip-info">
                    <span>⏱ 6 Days</span>
                    <span>🏔 Moderate</span>
                    <span>⭐ 4.8</span>
                </div>

                <div class="trip-bottom">

                    <div class="price">
                        ₹9,999 <small>/ person</small>
                    </div>

                    <button class="add-cart"
                            onclick="addToCart('Himachal Adventure',9999,'Himachal Pradesh','https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=500&q=80')">
                        + Cart
                    </button>

                </div>

            </div>

        </article>

        <!-- TRIP 3 -->
        <article class="trip-card"
                 data-name="Kashmir Great Lakes"
                 data-location="Kashmir"
                 data-category="Trekking">

            <div class="trip-image">

                <img src="https://images.unsplash.com/photo-1605649487212-47bdab064df7?auto=format&fit=crop&w=1000&q=80">

            </div>

            <div class="trip-content">

                <div class="location">
                    📍 Kashmir
                </div>

                <h3>Kashmir Great Lakes</h3>

                <div class="trip-info">
                    <span>⏱ 8 Days</span>
                    <span>🏔 Difficult</span>
                    <span>⭐ 4.9</span>
                </div>

                <div class="trip-bottom">

                    <div class="price">
                        ₹14,999 <small>/ person</small>
                    </div>

                    <button class="add-cart"
                            onclick="addToCart('Kashmir Great Lakes',14999,'Kashmir','https://images.unsplash.com/photo-1605649487212-47bdab064df7?auto=format&fit=crop&w=500&q=80')">
                        + Cart
                    </button>

                </div>

            </div>

        </article>

        <!-- TRIP 4 -->
        <article class="trip-card"
                 data-name="Gujarat Weekend Escape"
                 data-location="Gujarat"
                 data-category="Weekend">

            <div class="trip-image">

                <img src="https://images.unsplash.com/photo-1514222134-b57cbb8ce073?auto=format&fit=crop&w=1000&q=80">

            </div>

            <div class="trip-content">

                <div class="location">
                    📍 Gujarat
                </div>

                <h3>Gujarat Weekend Escape</h3>

                <div class="trip-info">
                    <span>⏱ 3 Days</span>
                    <span>🏕 Easy</span>
                    <span>⭐ 4.7</span>
                </div>

                <div class="trip-bottom">

                    <div class="price">
                        ₹4,499 <small>/ person</small>
                    </div>

                    <button class="add-cart"
                            onclick="addToCart('Gujarat Weekend Escape',4499,'Gujarat','https://images.unsplash.com/photo-1514222134-b57cbb8ce073?auto=format&fit=crop&w=500&q=80')">
                        + Cart
                    </button>

                </div>

            </div>

        </article>

        <!-- TRIP 5 -->
        <article class="trip-card"
                 data-name="Rajasthan Desert Camp"
                 data-location="Rajasthan"
                 data-category="Camping">

            <div class="trip-image">

                <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=1000&q=80">

            </div>

            <div class="trip-content">

                <div class="location">
                    📍 Rajasthan
                </div>

                <h3>Rajasthan Desert Camp</h3>

                <div class="trip-info">
                    <span>⏱ 3 Days</span>
                    <span>🏕 Easy</span>
                    <span>⭐ 4.8</span>
                </div>

                <div class="trip-bottom">

                    <div class="price">
                        ₹5,499 <small>/ person</small>
                    </div>

                    <button class="add-cart"
                            onclick="addToCart('Rajasthan Desert Camp',5499,'Rajasthan','https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=500&q=80')">
                        + Cart
                    </button>

                </div>

            </div>

        </article>

        <!-- TRIP 6 -->
        <article class="trip-card"
                 data-name="Kerala Explorer"
                 data-location="Kerala"
                 data-category="Road Trip">

            <div class="trip-image">

                <img src="https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=1000&q=80">

            </div>

            <div class="trip-content">

                <div class="location">
                    📍 Kerala
                </div>

                <h3>Kerala Explorer</h3>

                <div class="trip-info">
                    <span>⏱ 6 Days</span>
                    <span>🚙 Easy</span>
                    <span>⭐ 4.8</span>
                </div>

                <div class="trip-bottom">

                    <div class="price">
                        ₹10,999 <small>/ person</small>
                    </div>

                    <button class="add-cart"
                            onclick="addToCart('Kerala Explorer',10999,'Kerala','https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=500&q=80')">
                        + Cart
                    </button>

                </div>

            </div>

        </article>

    </div>

</section>


<!-- ================= CTA ================= -->

<section class="cta">

    <h2>
        Your next great story is waiting.
    </h2>

    <p>
        Pack your bags, leave the routine behind and discover
        places that stay with you forever.
    </p>

    <button class="btn-primary" onclick="openLogin()">
        Start Your Journey →
    </button>

</section>
